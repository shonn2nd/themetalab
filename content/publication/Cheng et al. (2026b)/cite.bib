
@article{chengEquityMattersAcademic2026,
	title = {Equity matters for academic performance in online learning: the roles of motivational beliefs and prior experience},
	volume = {45},
	issn = {1046-1310, 1936-4733},
	shorttitle = {Equity matters for academic performance in online learning},
	url = {https://link.springer.com/10.1007/s12144-026-09978-7},
	doi = {10.1007/s12144-026-09978-7},
	abstract = {The shift to online learning in higher education, accelerated by the COVID-19 pandemic, has become more prominent. However, disparities in access to essential resources—such as physical, human, and social support—have limited some students’ ability to fully engage in online education. This inequality has made the concept of equity in online learning a critical area of research. This study aims to explore how students’ perceptions of the learning environment—particularly instructor support, peer interaction, and equity—relate to their academic performance in an online undergraduate computer science course. A sample of 146 students participated in the study. Through moderated mediation analysis, the findings indicated that both instructor support and equity were positively related to final course grades through academic self-efficacy, with a stronger relation observed for students with more prior online learning experience. In addition, perceived equity was positively related to final course grades through a decrease in perceived costs. Peer interaction was not found to be related to final course grades. Among the various factors, perceived equity showed the strongest association with academic success. This research underscores the significance of perceived equity in online learning and discusses how online courses might be structured to foster inclusion and motivation among all students.},
	language = {en},
	number = {17},
	urldate = {2026-08-31},
	journal = {Current Psychology},
	author = {Cheng, Shonn and Ku, Sung-Chan and Annisa, Nurul and Lester, Li-Jen},
	month = sep,
	year = {2026},
	pages = {1435},
}
